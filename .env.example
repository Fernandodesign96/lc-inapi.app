# Raíz del monorepo (opcional)
# LC_REPO_ROOT=/home/fernando/projects/lc-inapi-app

# Secreto worker ↔ API (header X-Worker-Secret).
# Para Next (`bun run dev`): definir también en frontend/.env.local
# (ver frontend/.env.example).
AUDIT_JOBS_WORKER_SECRET=cambiar-en-local

# Worker local (`bun run worker:audit-jobs`)
# AUDIT_JOBS_API_BASE=http://127.0.0.1:3000
# AUDIT_JOBS_WORKER_ID=pc-local
# AUDIT_JOBS_WORKER_MODE=stub
# AUDIT_JOBS_POLL_MS=30000
# AUDIT_JOBS_OUTSIDE_MS=60000
# Solo pruebas locales fuera de 8–18: AUDIT_JOBS_WORKER_IGNORE_HOURS=1

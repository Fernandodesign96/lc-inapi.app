# Copia a `.env.local` (no versionar). Next carga este directorio.

# Raíz del monorepo si `data/` no se resuelve desde cwd
# LC_REPO_ROOT=/home/fernando/projects/lc-inapi-app

# Secreto compartido con el worker PC (header X-Worker-Secret)
AUDIT_JOBS_WORKER_SECRET=cambiar-en-local

# El script worker lee el secreto desde el entorno del shell / .env en la raíz:
#   AUDIT_JOBS_WORKER_SECRET=… bun run worker:audit-jobs -- --once
